{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openkannada/legacy-encodings/schema/layout.schema.json",
  "title": "Kannada legacy layout table",
  "description": "One legacy Kannada glyph layout: which Unicode text each glyph code, or sequence of codes, stands for. Section 4 of the specification defines the fields.",
  "type": "object",
  "required": ["spec_version", "id", "name", "byte_encoding", "draws_latin", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "spec_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "description": { "type": "string" },
    "fonts": { "type": "array", "items": { "type": "string" } },
    "byte_encoding": { "const": "windows-1252" },
    "draws_latin": { "type": "boolean" },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "path"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string" }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "code": { "type": "string", "pattern": "^[0-9A-F]{2}$" },
    "entry": {
      "type": "object",
      "required": ["codes", "kind", "value"],
      "additionalProperties": false,
      "properties": {
        "codes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/code" } },
        "kind": { "enum": ["letter", "base", "sign", "ottu", "arka", "mod", "aspirate", "ignore", "literal"] },
        "value": { "type": "string" },
        "prefer": { "$ref": "#/$defs/prefer" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["arka", "aspirate", "ignore"] } } },
          "then": { "properties": { "value": { "const": "" } } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["letter", "base", "ottu", "mod", "literal"] } } },
          "then": { "properties": { "value": { "minLength": 1 } } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["letter", "base", "mod", "ignore", "literal"] } } },
          "then": { "properties": { "prefer": { "properties": { "type": { "const": "read" } } } } }
        }
      ]
    },
    "prefer": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["on", "with", "after-ottu", "read"] },
        "chars": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 1 } }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["on", "with"] } } },
          "then": { "required": ["chars"] },
          "else": { "not": { "required": ["chars"] } }
        }
      ]
    }
  }
}
