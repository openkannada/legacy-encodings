{
  "normalize": "Keep the ASCII letters and digits of the font name, lowercased; drop everything else.",
  "not_legacy": [
    { "match": "uni", "why": "Unicode fonts, such as Nudi Unicode 01 and BRH Kannada Unicode" }
  ],
  "layout_rules": [
    { "match": "^brh(devanagari|sanskrit|hindi|marathi|tamil|telugu|malayalam|bengali|gujarati|gurmukhi)", "layout": null, "why": "Baraha's BRH fonts for other scripts" },
    { "match": "^brh", "layout": "nudi" },
    { "match": "^nudibakshar", "layout": "nudi-b" },
    { "match": "^kaneng", "layout": "kan-eng" },
    { "match": "^akrutikndpadma", "layout": "akruti" },
    { "match": "^shreekan0850([^0-9]|$)", "layout": "shree-lipi" },
    { "match": "^nudi([0-9]{2}.|akshar)", "layout": "nudi" }
  ],
  "legacy_without_table": [
    { "match": "^shreekan[0-9]", "why": "Other Shree-Lipi Shree-Kan fonts, such as Shree-Kan-0851" }
  ],
  "kannada_digits": [
    { "match": "^nudi[0-9]{2}k", "why": "The k variants of the numbered Nudi fonts draw Kannada digits at the ASCII digit codes" }
  ],
  "examples": [
    { "font": "Nudi 01 e", "layout": "nudi", "legacy": true, "kannada_digits": false },
    { "font": "Nudi 05 k", "layout": "nudi", "legacy": true, "kannada_digits": true },
    { "font": "NudiAkshara", "layout": "nudi", "legacy": true, "kannada_digits": false },
    { "font": "Nudi Akshar-14", "layout": "nudi", "legacy": true },
